#!/usr/bin/env -S LC_ALL=C bash
# Pin the graded source tree to the target commit.
#
# verify_committer.py picks the commit to grade (target_sha); without this
# step the workflow would compile and grade the pushed HEAD instead, so a
# commit after the deadline could be graded under an earlier commit's
# timestamp. This restores every target-commit source file while keeping the
# TA-owned grading harness (protected_list.txt) at the grading version.
#
# Required env: TARGET_SHA — the commit to grade.
set -euo pipefail

TARGET_SHA="${TARGET_SHA:-}"
if [ -z "$TARGET_SHA" ]; then
    echo "Error: TARGET_SHA is not set." >&2
    exit 1
fi

GRADING_SHA="$(git rev-parse HEAD)"
if [ "$GRADING_SHA" = "$TARGET_SHA" ]; then
    echo "Target commit is already HEAD; nothing to pin."
    exit 0
fi

# Read the harness list from the grading version, not the worktree — a target
# commit with a shrunken protected_list.txt must not re-expose harness files.
mapfile -t PROTECTED < <(git show "$GRADING_SHA:doc/protected_list.txt" \
                         | sed 's/#.*//' | grep -vE '^[[:space:]]*$')

# Fail closed: if the protected list comes back empty (file missing, parse
# broken, git show silently succeeded with empty output) we must abort rather
# than restore everything from target_sha — including the harness.
if [ "${#PROTECTED[@]}" -eq 0 ]; then
    echo "Error: protected_list.txt from $GRADING_SHA is empty or unreadable." >&2
    echo "Refusing to restore from $TARGET_SHA without a known harness boundary." >&2
    exit 1
fi

is_protected() {
    local f="$1" p
    for p in "${PROTECTED[@]}"; do
        p="${p%/}"
        # shellcheck disable=SC2254 — glob match against protected_list patterns
        case "$f" in $p | "$p"/*) return 0 ;; esac
    done
    return 1
}

restore=()
while IFS= read -r f; do
    is_protected "$f" || restore+=("$f")
done < <(git ls-tree -r --name-only "$TARGET_SHA")

if [ "${#restore[@]}" -gt 0 ]; then
    git checkout --quiet "$TARGET_SHA" -- "${restore[@]}"
fi

echo "Pinned ${#restore[@]} student source file(s) to target commit ${TARGET_SHA}."
echo "TA-owned harness kept at grading commit ${GRADING_SHA}."
