#!/usr/bin/env -S LC_ALL=C bash
# Pre-commit hook to protect critical files

# Only use colors when outputting to a terminal
if [ -t 1 ]; then
    RED='\033[0;31m'
    YELLOW='\033[1;33m'
    RESET='\033[0m'
else
    RED=''
    YELLOW=''
    RESET=''
fi

PROTECTED_LIST="doc/protected_list.txt"

# [DOUBLE DEFENSE] Detect unsynced TA updates before committing.
# Uses sync-check (read-only, non-interactive) — interactive sync is unsafe
# inside hooks: GUI clients may have no stdin TTY, and running `read` here
# would either hang or read unintended data.
if [ -f "./mp.sh" ]; then
    ./mp.sh sync-check || exit 1
fi

if [ ! -f "$PROTECTED_LIST" ]; then
    exit 1
fi

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only)

check_student_identity() {
    local conf="student.conf"
    if [ ! -f "$conf" ]; then
        return 0
    fi
    
    if grep -q "b00000000" "$conf" || grep -q "Your Name" "$conf" || grep -q "your-github-id" "$conf"; then
        echo -e "${RED}[ERROR] Default identity detected in student.conf!${RESET}"
        echo -e "Please fill out your real info (Student ID, Name, GitHub ID) before committing."
        echo ""
        exit 1
    fi
}

check_student_identity

# Read protected patterns and check against staged files
VIOLATIONS=()
while IFS= read -r pattern || [[ -n "$pattern" ]]; do
    [[ "$pattern" =~ ^#.* ]] && continue # Skip comments
    [[ -z "$pattern" ]] && continue      # Skip empty lines
    
    # Support glob patterns using bash [[ $file == $pattern ]]
    # DO NOT quote $pattern here, as we WANT glob matching.
    for file in $STAGED_FILES; do
        if [[ "$file" == $pattern ]]; then
            VIOLATIONS+=("$file")
        fi
    done
done < "$PROTECTED_LIST"

if [ ${#VIOLATIONS[@]} -ne 0 ]; then
    echo -e "${RED}[ERROR] Illegal modification to protected files detected:${RESET}"
    for v in "${VIOLATIONS[@]}"; do
        echo -e "  - $v"
    done
    echo ""
    echo -e "${YELLOW}[HINT] These files are overwritten during official grading and should NOT be modified.${RESET}"
    echo -e "${YELLOW}      If you are a TA or maintainer and must commit these, use 'git commit --no-verify'.${RESET}"
    exit 1
fi

exit 0
