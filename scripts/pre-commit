#!/bin/bash
# Pre-commit hook to protect critical files

PROTECTED_LIST="doc/protected_list.txt"

if [ ! -f "$PROTECTED_LIST" ]; then
    exit 0
fi

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only)

check_student_identity() {
    local conf="student.conf"
    if [ ! -f "$conf" ]; then
        return 0
    fi
    
    if grep -q "b00000000" "$conf" || grep -q "Your Name" "$conf" || grep -q "your-github-id" "$conf"; then
        echo -e "\033[0;31m[ERROR] Default identity detected in student.conf!\033[0m"
        echo -e "Please fill out your real info (Student ID, Name, GitHub ID) before committing."
        echo ""
        exit 1
    fi
}

check_student_identity

# Read protected patterns and check against staged files
VIOLATIONS=()
while IFS= read -r pattern || [[ -n "$pattern" ]]; do
    [[ "$pattern" =~ ^#.* ]] && continue # Skip comments
    [[ -z "$pattern" ]] && continue      # Skip empty lines
    
    # Support glob patterns using bash [[ $file == $pattern ]]
    # DO NOT quote $pattern here, as we WANT glob matching.
    for file in $STAGED_FILES; do
        if [[ "$file" == $pattern ]]; then
            VIOLATIONS+=("$file")
        fi
    done
done < "$PROTECTED_LIST"

if [ ${#VIOLATIONS[@]} -ne 0 ]; then
    echo -e "\033[0;31m[ERROR] Illegal modification to protected files detected:\033[0m"
    for v in "${VIOLATIONS[@]}"; do
        echo -e "  - $v"
    done
    echo ""
    echo -e "\033[1;33m[HINT] These files are overwritten during official grading and should NOT be modified.\033[0m"
    echo -e "\033[1;33m      If you are a TA or maintainer and must commit these, use 'git commit --no-verify'.\033[0m"
    exit 1
fi

exit 0
